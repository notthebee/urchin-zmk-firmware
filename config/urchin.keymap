/*
 * Ported from zmk-config-totem. TOTEM is 38 keys, Urchin is 34.
 * Dropped: the two outer bottom-row keys (ctrl/esc, ctrl/') and the outer
 * left/right thumb keys (bspc, del). Totem thumb order is
 * outer -> inner left: bspc, [nav] tilde, space | inner -> outer right:
 * tab, [sym] grave, delete, so the 4 surviving thumbs are
 * nav/tilde, space | sym/grave, tab.
 *
 * Deliberately left unmapped for now (totem had them on the dropped keys):
 * BSPC, DEL, ESC, SQT.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE   0
#define NAV    1
#define SYM    2
#define ADJ    3
#define GAMING 4

&mt {
    quick-tap-ms = <150>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt { quick-tap-ms = <175>; };

/ {
    combos {
        compatible = "zmk,combos";

        // totem used the extra bottom-right key (dropped); FSLH is its neighbour

        dash {
            bindings = <&kp MINUS>;
            key-positions = <19 18>;
            timeout-ms = <70>;
        };

        enter_right_combo {
            bindings = <&kp ENTER>;
            key-positions = <16 18 17>;
            timeout-ms = <70>;
            require-prior-idle-ms = <100>;
        };

        russian_letter_ {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <8 9>;
            timeout-ms = <20>;
            require-prior-idle-ms = <100>;
        };

        russian_letter_x {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <8 7>;
            require-prior-idle-ms = <100>;
            timeout-ms = <20>;
        };

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <0 1>;
            layers = <BASE>;
            timeout-ms = <25>;
            require-prior-idle-ms = <80>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <20 11>;
            timeout-ms = <30>;
            require-prior-idle-ms = <80>;
        };

        escape {
            bindings = <&kp ESC>;
            key-positions = <11 10>;
            timeout-ms = <30>;
            require-prior-idle-ms = <80>;
        };

        copy {
            bindings = <&kp K_COPY>;
            key-positions = <21 22>;
            timeout-ms = <30>;
            require-prior-idle-ms = <80>;
            layers = <0>;
        };

        paste {
            bindings = <&kp K_PASTE>;
            key-positions = <22 23>;
            timeout-ms = <30>;
            require-prior-idle-ms = <80>;
            layers = <0>;
        };

        at {
            bindings = <&kp AT_SIGN>;
            key-positions = <1 11>;
            timeout-ms = <30>;
            require-prior-idle-ms = <80>;
            layers = <0>;
        };
    };

    behaviors {
        mt_left: mt_left {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 32 33>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
        };

        mt_right: mt_right {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 31 30>;
        };

        mt_shift_left: mt_shift_left {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_SHIFT_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 32 33 25>;
            require-prior-idle-ms = <30>;
        };

        mt_shift_right: mt_shift_right {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_SHIFT_RIGHT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 32 33 31 30>;
            require-prior-idle-ms = <30>;
        };

        hold_sticky: hold_sticky {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_STICKY";
            bindings = <&kp>, <&sk>;

            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <150>;
            quick-tap-ms = <220>;
        };

        mt_all: mt_all {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_ALL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <175>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            require-prior-idle-ms = <35>;
            hold-trigger-on-release;
        };

        lt_thumb: lt_thumb {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_THUMB";
            bindings = <&lt>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <100>;
            quick-tap-ms = <220>;
            require-prior-idle-ms = <0>;
            flavor = "balanced";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "BASE";
            bindings = <
&kp Q             &kp W                  &kp E            &kp R                    &kp T      &kp Y    &kp U                     &kp I             &kp O                   &kp P
&mt_left LCTRL A  &mt_shift_left LALT S  &mt_left LGUI D  &mt_shift_left LSHIFT F  &kp G      &kp H    &mt_shift_right LSHIFT J  &mt_right LGUI K  &mt_shift_right LALT L  &mt_right RCTRL SEMICOLON
&kp Z             &kp X                  &kp C            &kp V                    &kp B      &kp N    &kp M                     &kp COMMA         &kp DOT                 &kp FSLH
                                                          &lt 1 BACKSPACE          &kp SPACE  &kp TAB  &lt 2 ESC
            >;
        };

        nav_layer {
            label = "NAVI";
            bindings = <
&kp GRAVE      &kp UNDER       &kp UP          &kp PLUS         &kp LBRC  &kp RBRC  &kp N7        &kp N8  &kp N9        &kp EQUAL
&mt LCTRL ESC  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LBKT  &kp RBKT  &kp NUMBER_4  &kp N5  &kp NUMBER_6  &kp BACKSPACE
&tog 4         &kp PG_UP       &kp LG(DOWN)    &kp PG_DN        &kp LPAR  &kp RPAR  &kp NUMBER_1  &kp N2  &kp N3        &kp KP_MULTIPLY
                                               &trans           &trans    &kp N0    &kp PERIOD
            >;
        };

        sim_layer {
            label = "SYM";
            bindings = <
&kp EXCL     &kp AT  &kp HASH  &kp DLLR       &kp PRCNT             &kp CARET     &kp AMPS         &kp ASTERISK  &kp SQT     &kp DQT
&kp RA(A)    &trans  &trans    &trans         &trans                &kp C_MUTE    &kp PRINTSCREEN  &trans        &trans      &kp BACKSPACE
&kp RA(F18)  &trans  &trans    &kp C_BRI_DEC  &kp C_BRIGHTNESS_INC  &kp C_VOL_DN  &kp C_VOL_UP     &kp C_PREV    &kp C_NEXT  &kp BSLH
                               &trans         &mo ADJ               &kp C_PP      &trans
            >;
        };

        adjust_layer {
            label = "ADJ";
            bindings = <
&sys_reset   &bt BT_CLR  &out OUT_TOG  &trans  &trans  &trans  &kp F7  &kp F8  &kp F9  &kp F12
&bootloader  &bt BT_NXT  &trans        &trans  &trans  &trans  &kp F4  &kp F5  &kp F6  &kp F11
&trans       &bt BT_PRV  &trans        &trans  &trans  &trans  &kp F1  &kp F2  &kp F3  &kp F10
                                       &trans  &trans  &trans  &trans
            >;
        };

        gaming {
            label = "GAME";
            bindings = <
&kp Q             &kp W             &kp E             &kp R     &kp T      &trans     &trans  &trans  &trans  &trans
&mt LCTRL ESC     &kp S             &kp D             &kp F     &kp N6     &trans     &trans  &trans  &trans  &trans
&kp LC(NUMBER_1)  &kp LC(NUMBER_2)  &kp LC(NUMBER_3)  &kp N5    &kp B      &trans     &trans  &trans  &trans  &tog GAMING
                                                      &kp LALT  &kp SPACE  &kp LCTRL  &trans
            >;
        };

        gaming_2 {
            bindings = <
&kp LC(Q)  &kp LC(W)  &kp LC(E)  &kp LC(R)  &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans     &trans     &trans     &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans     &trans     &trans     &trans  &trans  &trans  &trans  &trans  &trans
                                 &trans     &trans  &trans  &trans
            >;
        };
    };
};
